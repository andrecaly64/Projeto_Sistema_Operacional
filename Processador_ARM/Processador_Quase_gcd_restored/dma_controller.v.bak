module dma_controller (clk, reset, cpu_addr, cpu_wdata, cpu_we, cpu_rdata, hd_addr, hd_data, ram_inst_addr, ram_inst_data, ram_inst_we);

input wire clk;
input wire reset;
input wire [9:0] cpu_addr;
input wire [31:0] cpu_wdata;
input wire cpu_we;
output reg [31:0] cpu_rdata;
output wire [11:0] hd_addr;
input wire [31:0] hd_data;
output reg [9:0] ram_inst_addr;
output reg [31:0] ram_inst_data;
output reg ram_inst_we;
output wire dma_busy;

reg [5:0] reg_sector;
reg [9:0] reg_dest_addr;
reg reg_start;

localparam S_IDLE = 2'b00;
localparam S_READ_HD = 2'b01;
localparam S_WRITE_RAM = 2'b10;
localparam S_DONE = 2'b11;

assign dma_busy = (state != S_IDLE);
assign hd_addr = {reg_sector, word_count};

always @(posedge clk or posedge reset) begin
	if (reset) begin
		reg_sector <= 6'd0;
		reg_dest_addr <= 10'd0;
		reg_start <= 1'b0;
	end else begin
		reg_start <= 1'b0;
		
		if (cpu_we) begin
			case (cpu_addr)
				10'd1000: reg_sector <= cpu_wdata[5:0];
				10'd1001: reg_dest_addr <= cpu_wdata[9:0];
				10'd1002: reg_start <= cpu_wdata[0];
			endcase
		end
	end
end

always @(*) begin
	case (cpu_addr)
		10'd1000: cpu_rdata = {26'd0, reg_sector};
		10'd1001: cpu_rdata = {22'd0, reg_dest_addr};
		10'd1002: cpu_rdata = {31'd0, reg_start};
		10'd1003: cpu_rdata = {31'd0, dma_busy};
		default: cpu_rdata = 32'd0;
	endcase
end

always @(posedge clk or posedge reset) begin
	if (reset) begin
		state <= S_IDLE;
		word_count <= 6'd0;
		ram_inst_we <= 1'b0;
		ram_inst_addr <= 10'd0;
		ram_inst_data <= 32'd0;
	end else begin
		case (state)
			S_IDLE: begin
				ram_inst_we <= 1'b0;
				if (reg_start) begin
					word_count < 6'd0;
					state <= S_READ_HD;
				end
			end
			
			S_READ_HD: begin
				ram_inst_we <= 1'b0;
				state <= S_WRITE_RAM;
			end
			
			S_WRITE_RAM: begin
				ram_inst_addr <= reg_dest_addr + word_count;
				ram_inst_data <= hd_data;
				ram_inst_we <= 1'b1;
				
				if (word_count == 6'd63) begin
					state <= S_DONE;
				end else begin
					word_count <= word_count + 1'b1;
					state <= S_READ_HD;
				end
			end
			
			S_DONE: begin
				ram_inst_we <= 1'b0;
				state <= S_IDLE;
			end
			
			default: state <= S_IDLE;
		endcase
	end
end
endmodule
